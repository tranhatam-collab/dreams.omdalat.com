{
  "name": "dreams.omdalat.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "wrangler d1 execute dreams-om-dalat-db --remote --file=migrations/0001_initial.sql",
    "migrate": "wrangler d1 migrations apply dreams-om-dalat-db --remote",
    "cf:build": "opennextjs-cloudflare build",
    "deploy": "npm run cf:build && node scripts/deploy-worker.mjs",
    "dev:cf": "wrangler dev",
    "lint": "eslint",
    "lint:src": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "bcryptjs": "^3.0.3",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.105.0"
  }
}
